{
    "schema_version": 1,
    "id": "actionlint-src",
    "name": "actionlint",
    "version": "1.7.4",
    "type": "source",
    "description": "Static checker for GitHub Actions workflow files (source build)",
    "homepage": "https://github.com/rhysd/actionlint",
